// Nova AI Studio - Prisma Schema
// 数据库: PostgreSQL (Supabase / Neon 免费层)
// 生成客户端: npx prisma generate
// 推送表结构: npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

model User {
  id                   String    @id @default(cuid())
  name                 String?
  email                String    @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  role                 Role      @default(USER)
  plan                 Plan      @default(FREE)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String? // active / trialing / past_due / canceled
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  generations Generation[]
  orders      Order[]
}

// ---- NextAuth 标准模型 ----
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- 业务模型 ----

// 每次 AI 生成记录（用于配额统计与管理员审计）
model Generation {
  id        String   @id @default(cuid())
  userId    String
  type      String // short | novel | code | chat
  prompt    String   @db.Text
  output    String   @db.Text
  engine    String? // 实际使用的模型/引擎
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// 订单（Stripe Checkout 会话）
model Order {
  id              String    @id @default(cuid())
  userId          String
  stripeSessionId String?   @unique
  plan            Plan
  amount          Int // 美分，如 990 = $9.90
  currency        String    @default("usd")
  status          String    @default("pending") // pending | paid | canceled | refunded
  createdAt       DateTime  @default(now())
  paidAt          DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// 站点设置（管理员可改）
model SiteSettings {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
