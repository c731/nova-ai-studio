# ============================================================
# Nova AI 网关环境变量模板
# 复制为 .env 后填入你自己的密钥（本地运行前 source 或手动 export）
# 部署 Vercel 时：在控制台 Settings → Environment Variables 里逐项添加
# 注意：密钥永远不要提交到 GitHub！
# ============================================================

# 服务端口（本地运行用，默认 8787）
PORT=8787

# 允许跨域的前端来源（填你的 GitHub Pages 地址，* 表示全放开）
ALLOW_ORIGIN=https://c731.github.io

# OpenRouter（免费注册 https://openrouter.ai/keys，可用 :free 模型）
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# DeepSeek 官方（https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=

# 阿里通义千问 DashScope（https://dashscope.console.aliyun.com/apiKey）
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-turbo
