# ============ Nova AI Studio 环境变量示例 ============
# 复制本文件为 .env 并填入真实值：cp .env.example .env

# ---- 数据库（Supabase / Neon 免费层 PostgreSQL 连接串） ----
# Supabase: 项目面板 → Settings → Database → Connection string (URI)
# Neon:     控制台 → Dashboard → Connect 复制 connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ---- NextAuth ----
# 本地开发用 http://localhost:3000；部署后改成 https://你的vercel域名
NEXTAUTH_URL="http://localhost:3000"
# 生成方法: openssl rand -base64 32
NEXTAUTH_SECRET="换成随机字符串_openssl_rand_base64_32"

# ---- 站点地址（Stripe 回跳用） ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- AI 模型（OpenAI 兼容格式，任选其一） ----
# OpenAI 官方:
# OPENAI_API_BASE="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"
# OpenRouter（有大量免费模型，推荐）:
# OPENAI_API_BASE="https://openrouter.ai/api/v1"
# OPENAI_MODEL="meta-llama/llama-3.1-8b-instruct:free"
# 硅基流动 SiliconFlow（国内可直连，有免费额度）:
# OPENAI_API_BASE="https://api.siliconflow.cn/v1"
# OPENAI_MODEL="Qwen/Qwen2.5-7B-Instruct"
OPENAI_API_BASE="https://api.openai.com/v1"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ---- Stripe（先用测试模式跑通全流程） ----
# Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_你的测试密钥"
# 在 Stripe 控制台创建两个订阅价格后，复制 price_xxx：
# Products → Add product → 定价 $9.9/月(recurring) → 复制 Price ID
STRIPE_PRICE_PRO="price_你的Pro价格ID"
STRIPE_PRICE_ENTERPRISE="price_你的企业版价格ID"
# Webhook 签名（本地用 stripe CLI 获取；Vercel 上在 Dashboard 配置 endpoint 后获取）
STRIPE_WEBHOOK_SECRET=""
